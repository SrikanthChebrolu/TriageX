{
  "name": "triagex",
  "version": "1.0.0",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "dev:all": "concurrently --names \"API,UI\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"node --watch src/main.js\" \"cd frontend && npm run dev\"",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=src",
    "ui": "cd frontend && npm run dev",
    "ui:build": "cd frontend && npm run build"
  },
  "dependencies": {
    "@langchain/core": "^0.1.60",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "langchain": "^0.1.37",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".js"
    ],
    "transform": {}
  }
}
